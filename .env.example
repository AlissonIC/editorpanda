APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mercado Pago (checkout transparente — cartão + PIX). Sem webhook: front polla status.
# Prod: APP_USR-* / Sandbox: TEST-* (o service auto-detecta pela prefixo do token).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_PIX_EXPIRA_MIN=30

# Tem que ser MAIOR que o timeout dos jobs de vídeo (1920s). Se for menor, a
# fila considera o encode travado, devolve o job pra outro worker e o vídeo
# falha sozinho com MaxAttemptsExceededException.
DB_QUEUE_RETRY_AFTER=1980

# Quantos `queue:work` você mantém rodando (supervisor/systemd) = vídeos
# processados em paralelo. O app usa isso pra dividir os cores entre os encodes
# (threads = cores / workers), então mantenha em dia ao subir/derrubar worker.
QUEUE_WORKERS=1

# Threads por encode. Vazio = automático (cores / QUEUE_WORKERS). Preencha só
# pra deixar folga quando a máquina divide CPU com web/banco.
FFMPEG_THREADS=

# Encode dos vídeos. O preset é o que mais pesa no tempo de fila — medido num
# clipe de 17s: medium 45s · fast 34s · veryfast 20s. A resolução de ENTRADA
# quase não importa (4K custa ~5% a mais que Full HD), porque a saída é sempre
# 1080x1920. Se subir pra veryfast e notar perda, baixe o CRF em 1.
FFMPEG_PRESET=fast
FFMPEG_CRF=22

VITE_APP_NAME="${APP_NAME}"
